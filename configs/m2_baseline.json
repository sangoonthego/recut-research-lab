{
  "experiment_id": "m2_baseline_v001",
  "random_seed": 42,
  "data": {
    "dataset_name": "cyberagent/AdTEC",
    "config_name": "ad-consistency",
    "raw_dir": "data/raw/adtec_consistency",
    "train_split": "train",
    "eval_split": "valid",
    "test_split_protected": true,
    "separator": " [SEP] ",
    "normalize_unicode_nfkc": true
  },
  "vectorizer": {
    "analyzer": "char",
    "ngram_range": [2, 4],
    "max_features": 50000,
    "min_df": 2,
    "sublinear_tf": true
  },
  "classifier": {
    "model_family": "LogisticRegression",
    "C": 1.0,
    "class_weight": null,
    "max_iter": 1000,
    "solver": "lbfgs"
  },
  "latency_benchmark": {
    "warmup_runs": 2,
    "timed_runs": 7,
    "method": "full_validation_batch_amortized_median"
  },
  "label_order": ["consistent", "inconsistent"],
  "zero_division_policy": 0,
  "baselines": [
    {
      "model_id": "B0_majority",
      "model_type": "majority",
      "input_features": "none (training label prior)",
      "input_mode": "none"
    },
    {
      "model_id": "B1_title_only",
      "model_type": "tfidf_logreg",
      "input_features": "title",
      "input_mode": "title"
    },
    {
      "model_id": "B2_lp_only",
      "model_type": "tfidf_logreg",
      "input_features": "lp_text",
      "input_mode": "lp_text"
    },
    {
      "model_id": "B3_pair",
      "model_type": "tfidf_logreg",
      "input_features": "title + [SEP] + lp_text",
      "input_mode": "pair"
    }
  ]
}
