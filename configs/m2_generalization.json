        "input_features": "none (training label prior)",
        "input_mode": "none"
      },
      {
        "model_id": "B1_title_only",
        "model_type": "tfidf_logreg",
        "input_features": "title",
        "input_mode": "title"
      },
      {
        "model_id": "B2_lp_only",
        "model_type": "tfidf_logreg",
        "input_features": "lp_text",
        "input_mode": "lp_text"
      },
      {
        "model_id": "B3_pair",
