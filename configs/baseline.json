{
  "experiment_name": "baseline_tfidf_logreg",
  "model_type": "tfidf_logreg",
  "random_seed": 42,
  "data": {
    "dataset_name": "adtec_consistency",
    "raw_dir": "data/raw/adtec_consistency",
    "text_fields": ["title", "lp_text"],
    "target_field": "label",
    "combine_strategy": "concat_separator",
    "separator": " [SEP] "
  },
  "vectorizer": {
    "analyzer": "char",
    "ngram_range": [1, 3],
    "min_df": 2,
    "max_features": 25000,
    "sublinear_tf": true
  },
  "classifier": {
    "C": 1.0,
    "class_weight": "balanced",
    "max_iter": 1000,
    "solver": "lbfgs"
  },
  "evaluation": {
    "metrics": [
      "accuracy",
      "macro_f1",
      "precision",
      "recall",
      "per_class_f1",
      "confusion_matrix",
      "inference_latency"
    ]
  }
}
