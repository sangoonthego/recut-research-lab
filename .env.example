# Environment configuration example for recut-research-lab
# Copy this file to .env and adjust variables as needed.

# Hugging Face Token (optional for public dataset cyberagent/AdTEC)
HF_TOKEN=

# Directory overrides (defaults to relative project directories)
RECUT_DATA_DIR=data
RECUT_MODELS_DIR=models
RECUT_REPORTS_DIR=reports/generated
RECUT_EXPERIMENTS_DIR=experiments/runs

# Global default random seed
RECUT_RANDOM_SEED=42

